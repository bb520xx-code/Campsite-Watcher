{
  "name": "campground-bot",
  "version": "1.0.0",
  "description": "Watches recreation.gov campgrounds and alerts you when a site opens up.",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "build": "electron-packager . CampgroundBot --platform=darwin --arch=arm64 --out=dist --icon=icon.icns --overwrite --prune=true --ignore=\"^/dist\" --ignore=\"^/README.md\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0"
  }
}
